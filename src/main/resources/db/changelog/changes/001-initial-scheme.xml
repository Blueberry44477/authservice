<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
   
    <changeSet id="17-05-2026-001" author="blueberry44477">
        <comment>Create initial scheme</comment>
        
        <createTable tableName="user">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user"/>
            </column>

            <column name="first_name" type="VARCHAR(50)"/>
            <column name="last_name" type="VARCHAR(50)"/>
            
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_user_email"/>
            </column>
            
            <column name="password" type="VARCHAR(255)"/>
            
            <column name="sex" type="VARCHAR(10)"/>
            
            <column name="dob" type="DATE">
                <constraints nullable="false"/>
            </column>
            
            <column name="phone" type="VARCHAR(20)"/>
            <column name="country" type="VARCHAR(100)"/>
            <column name="city" type="VARCHAR(100)"/>
            
            <column name="avatar" type="BLOB"/>
        </createTable>

        <!-- user_friends join table -->
        <createTable tableName="user_friends">
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="friend_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Add Primary Key for join table -->
        <addPrimaryKey tableName="user_friends" columnNames="user_id, friend_id" constraintName="pk_user_friends"/>

        <!-- Add Foreign Key for user_id -->
        <addForeignKeyConstraint baseTableName="user_friends" 
                                 baseColumnNames="user_id"
                                 constraintName="fk_user_friends_user_id"
                                 referencedTableName="user" 
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <!-- Add Foreign Key for friend_id -->
        <addForeignKeyConstraint baseTableName="user_friends" 
                                 baseColumnNames="friend_id"
                                 constraintName="fk_user_friends_friend_id"
                                 referencedTableName="user" 
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>